# Keep the token server-side. Do not prefix either variable with NEXT_PUBLIC_.
WORDPRESS_URL=https://marketing.readglr.com/cms
WORDPRESS_SERVICE_TOKEN=replace-with-a-private-server-token
SITE_URL=http://localhost:3000
# Use https://readglr.com for the Vercel Production environment.

# Set to true only on the canonical production deployment after smoke testing.
ROBOTS_INDEXING=false

# Required in production. The reverse proxy must overwrite this header.
RATE_LIMIT_IP_HEADER=x-vercel-forwarded-for
SUBSCRIPTION_SECRET=generate-a-separate-long-random-secret

# SMTP delivery for double opt-in and unsubscribe mail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=globalluxuryreporter@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=Global Luxury Reporter <globalluxuryreporter@gmail.com>

# Required legal identity shown in public notices.
LEGAL_ENTITY_NAME=Global Luxury Reporter
LEGAL_ADDRESS=Mumbai
PRIVACY_EMAIL=info@readglr.com
